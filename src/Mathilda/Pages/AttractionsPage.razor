@page "/attractions"
@using Microsoft.AspNetCore.Components
@using Mathilda.Services
@inject PlacesService Places

<h1>Nearby Attractions</h1>
<p>Places within 10 km of your current position (mock data until Convex is configured).</p>

@if (_attractions is null)
{
    <p><em>Loading attractions…</em></p>
}
else if (_attractions.Count == 0)
{
    <p>No attractions found nearby.</p>
}
else
{
    <div class="card-grid">
        @foreach (var item in _attractions)
        {
            <div class="card">
                <h3>@item.Name</h3>
                <p class="muted">@item.Type</p>
                <p>Distance: @item.DistanceKm.ToString("0.0") km</p>
                @if (item.OpenNow)
                {
                    <span class="badge badge-open">Open now</span>
                }
                else
                {
                    <span class="badge badge-closed">Closed</span>
                }
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<Mathilda.Models.Attraction>? _attractions;

    protected override async Task OnInitializedAsync()
    {
        _attractions = await Places.FetchNearby(10);
    }
}
