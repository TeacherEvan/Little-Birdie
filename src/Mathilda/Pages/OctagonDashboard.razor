@page "/"
@using Mathilda.Services
@inject NavigationManager Nav
@inject InstallPromptService InstallPrompt
@inject LocationService Location
@inject IJSRuntime JS

<div class="page">
    <div class="status-bar" role="status" aria-live="polite">
        <span class="status-badge @(_offlineReady ? "ok" : "offline")">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <strong>@(_offlineReady ? "Offline Ready" : "Online Only")</strong>
        </span>
        <span class="status-badge @(_gpsLocked ? "ok" : "warn")">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <strong>@(_gpsLocked ? "GPS Locked" : "GPS Pending")</strong>
        </span>
        <span class="status-badge @(_installAvailable ? "ok" : "offline")">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 17v-6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zm-9-8a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/></svg>
            <strong>@(_installAvailable ? "Install Available" : "Installed")</strong>
        </span>
    </div>

    <div class="install-banner" @style="(_installAvailable ? null : "display:none;")" role="status">
        <span>💡 Install Mathilda on your device for quick access!</span>
        <button class="btn btn-primary" @onclick="ShowInstallWizard">Install</button>
    </div>

    <div class="quick-chips" role="region" aria-label="Quick info">
        <span class="quick-chip">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
            <span>🇹🇭 Quick Currency: @_currencyText</span>
        </span>
        <span class="quick-chip">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <span>Weather: @_weatherText</span>
        </span>
    </div>

    <div class="octagon" role="navigation" aria-label="Main destinations">
        <button class="tile t1" @onclick="@(() => Nav.NavigateTo("/attractions"))" aria-label="Attractions">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Attractions</span>
        </button>
        <button class="tile t2" @onclick="@(() => Nav.NavigateTo("/weather"))" aria-label="Weather">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            <span>Weather</span>
        </button>
        <button class="tile t3" @onclick="@(() => Nav.NavigateTo("/cost"))" aria-label="Cost Calculator">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
            <span>Cost</span>
        </button>
        <button class="tile t4" @onclick="@(() => Nav.NavigateTo("/banking"))" aria-label="Banking">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16l7-3 7 3zM17 18H7v-1.5l7-3 7 3V18z"/></svg>
            <span>Banking</span>
        </button>
        <button class="tile t5" @onclick="@(() => Nav.NavigateTo("/bathroom"))" aria-label="Restroom Finder">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4c0-1.1.9-2 2-2h6c1.1 0 2 .9 2 2v5h-4V4h-4v5H7V4zm4 10c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/></svg>
            <span>Restroom</span>
        </button>
        <button class="tile t6" @onclick="@(() => Nav.NavigateTo("/bolt"))" aria-label="Ride / Bolt">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            <span>Bolt</span>
        </button>
        <button class="tile t7" @onclick="@(() => Nav.NavigateTo("/counter"))" aria-label="Counter">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 17h20v-2H2v2zm0-4h20v-2H2v2zm0-4h20v-2H2v2z"/></svg>
            <span>Counter</span>
        </button>
        <button class="tile t8" @onclick="@(() => Nav.NavigateTo("/location"))" aria-label="My Location">
            <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Location</span>
        </button>
    </div>

    <div class="dashboard-footer" role="contentinfo">
        <span><strong>🇹🇭 Quick Currency:</strong> @_currencyText</span>
        <span><strong>Weather:</strong> @_weatherText</span>
    </div>

    <p><a href="/settings">Settings</a></p>
</div>

@code {
    private bool _offlineReady;
    private bool _gpsLocked;
    private bool _installAvailable;
    private string _currencyText = "100 THB ≈ $2.85 USD";
    private string _weatherText = "31°C Sunny";

    protected override async Task OnInitializedAsync()
    {
        // Check offline readiness (service worker)
        try
        {
            var swReg = await JS.InvokeAsync<IJSObjectReference>("navigator.serviceWorker.getRegistration");
            _offlineReady = swReg != null;
        }
        catch { _offlineReady = false; }

        // Check GPS lock (location service)
        var loc = await Location.LoadAsync();
        _gpsLocked = loc != null;

        // Check install availability
        await InstallPrompt.InitializeAsync();
        _installAvailable = InstallPrompt.CanShowInstallPrompt;
    }

    private void ShowInstallWizard()
    {
        // The InstallWizardModal is rendered in MainLayout and will appear automatically
        // when CanShowInstallPrompt is true. This button just ensures the modal shows.
        StateHasChanged();
    }
}
