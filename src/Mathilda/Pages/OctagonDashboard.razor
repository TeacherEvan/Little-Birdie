@page "/"
@using Mathilda.Services
@inject NavigationManager Nav

<h1>Mathilda</h1>
<p>Your Thailand travel companion.</p>

<div class="octagon">
    <button class="tile t1" @onclick="@(() => Nav.NavigateTo("/attractions"))">Attractions</button>
    <button class="tile t2" @onclick="@(() => Nav.NavigateTo("/weather"))">Weather</button>
    <button class="tile t3" @onclick="@(() => Nav.NavigateTo("/cost"))">Cost</button>
    <button class="tile t4" @onclick="@(() => Nav.NavigateTo("/banking"))">Banking</button>
    <button class="tile t5" @onclick="@(() => Nav.NavigateTo("/bathroom"))">Bathroom</button>
    <button class="tile t6" @onclick="@(() => Nav.NavigateTo("/bolt"))">Bolt</button>
    <button class="tile t7" @onclick="@(() => Nav.NavigateTo("/counter"))">Counter</button>
    <button class="tile t8" @onclick="@(() => Nav.NavigateTo("/location"))">Location</button>
</div>

<p><a href="/settings">Settings</a></p>

<style>
.octagon { position: relative; width: 320px; height: 320px; margin: 1rem auto; }
.tile { position: absolute; width: 92px; height: 92px; border-radius: 12px; border: none; background: #1e88e5; color: white; font-weight: 600; cursor: pointer; }
.t1 { top: 0;    left: 114px; }
.t2 { top: 44px; left: 214px; }
.t3 { top: 138px;left: 228px; }
.t4 { top: 228px;left: 114px; }
.t5 { top: 138px;left: 0;     }
.t6 { top: 44px; left: 14px;  }
.t7 { top: 228px;left: 214px; }
.t8 { top: 0;    left: 0;     }
</style>
