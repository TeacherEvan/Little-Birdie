@page "/location"
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject LocationService Location
@inject NavigationManager Nav

<h1>Location</h1>

<div class="card">
    <p>Mathilda can use your device's location to find nearby attractions and current weather.</p>
    <button class="btn" @onclick="RequestLocation">Share my location</button>
</div>

<div class="card">
    @if (!string.IsNullOrEmpty(coords))
    {
        <h3>Your location</h3>
        <p>Latitude: @lat</p>
        <p>Longitude: @lng</p>
    }
    @if (!string.IsNullOrEmpty(status))
    {
        <p class="@statusClass">@status</p>
    }
    <p class="muted">Base URI: @Nav.BaseUri</p>
</div>

@code {
    private string coords = "";
    private double lat;
    private double lng;
    private string status = "";
    private string statusClass = "muted";

    private async Task RequestLocation()
    {
        status = "";
        var result = await Location.RequestGpsAsync();
        if (result is { } c)
        {
            lat = c.Lat;
            lng = c.Lng;
            coords = $"{c.Lat},{c.Lng}";
            await Location.SaveAsync(c.Lat, c.Lng, "GPS");
            status = "Location acquired.";
            statusClass = "ok";
        }
        else
        {
            status = "Location unavailable (permission denied, unsupported, or request failed).";
            statusClass = "error";
        }
    }
}
