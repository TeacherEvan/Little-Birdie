@inherits LayoutComponentBase
@inject AppSettingsService Settings
@inject PrivacyConsentService Consent
@inject InstallPromptService InstallPrompt
@inject LocationService Location

<div class="page">
    @if (!_appReady)
    {
        <StartupVideoIntro OnComplete="HandleStartupComplete" />
    }
    else
    {
        <main>
            @Body
        </main>

        <PrivacyConsentModal @ref="_consentModal" OnConsent="HandleConsent" />
        <LocationPromptModal OnLocationChosen="HandleLocation" OnDismissed="HandleLocationDismissed" />
        <InstallWizardModal />
    }
</div>

@code {
    private bool _appReady;
    private PrivacyConsentModal? _consentModal;
    private PrivacyConsent? _consent;

    protected override async Task OnInitializedAsync()
    {
        await InstallPrompt.InitializeAsync();
        _consent = await Consent.LoadAsync();
    }

    private async Task HandleStartupComplete()
    {
        _appReady = true;

        // Show privacy consent on first launch.
        await (_consentModal?.InitializeAsync() ?? Task.CompletedTask);
        StateHasChanged();
    }

    private void HandleConsent(PrivacyConsent consent)
    {
        // Consent captured; location prompt appears next in the onboarding flow.
        _consent = consent;
        StateHasChanged();
    }

    private async Task HandleLocation((double Lat, double Lng, string Name) loc)
    {
        // Persist the chosen location so weather/attractions reflect the real position.
        await Location.SaveAsync(loc.Lat, loc.Lng, loc.Name);
        StateHasChanged();
    }

    private void HandleLocationDismissed()
    {
        // User skipped location; downstream pages fall back to the last saved
        // location (or Bangkok default in the service), no telemetry emitted here.
        StateHasChanged();
    }
}
